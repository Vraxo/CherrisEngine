// A Overcore editor theme. Copy this file to
//   %APPDATA%/OvercoreEditor/Themes/my-theme.json      (Windows)
//   ~/.config/OvercoreEditor/Themes/my-theme.json      (Linux, macOS)
// then choose Theme > Reload Themes in either editor.
//
// Rules, all enforced when the file is read:
//   - "id" must be unique, and should match the file name. A file whose id matches a built-in theme
//     replaces that theme, so the shipped ones can be retuned without a rebuild.
//   - every role below is required, and an unknown role is an error, so no widget is left unthemed:
//     black, title, background, window-border, foldout, input, input-outline, recessed, panel,
//     header, dropdown, dropdown-outline, hover, hover-2, white, white-25, highlight, primary,
//     primary-hover, primary-press, secondary, foreground, foreground-hover, foreground-inverted,
//     foreground-header, select, select-inactive, select-parent, select-hover, notifications,
//     accent-blue, accent-purple, accent-pink, accent-red, accent-orange, accent-yellow,
//     accent-green, accent-brown, accent-black, accent-gray, accent-white, accent-folder, warning,
//     error, success, selection, selection-pressed, tab-hover
//   - colors are "#rrggbb" or "#rrggbbaa"; "provenance" is shown as the item's tooltip, so keep it honest.
//
// The values below are the Unreal Engine 5 theme: replace them.

{
  "id": "my-theme",
  "displayName": "My theme",
  "provenance": "Say where every value comes from: the source editor's palette, a design system, or you.",
  "typography": {
    "family": "Roboto",
    "monospaceFamily": "Roboto Mono",
    "bodyPixels": 13,
    "smallPixels": 11,
    "largePixels": 19,
    "fontResource": "Fonts/Roboto-Regular.TTF",
    "fallbackFontResource": "Fonts/RobotoMono-Regular.TTF",
    "cssStack": "\"Roboto\", \"Segoe UI\", system-ui, sans-serif",
    "boldWeight": 700
  },
  "metrics": {
    "cornerRadius": 4,
    "borderWidth": 1,
    "controlHeight": 22,
    "scrollbarWidth": 8
  },
  "colors": {
    "black": "#000000",
    "title": "#151515",
    "background": "#151515",
    "window-border": "#0f0f0f",
    "foldout": "#0f0f0f",
    "input": "#0f0f0f",
    "input-outline": "#383838",
    "recessed": "#1a1a1a",
    "panel": "#242424",
    "header": "#2f2f2f",
    "dropdown": "#383838",
    "dropdown-outline": "#4c4c4c",
    "hover": "#575757",
    "hover-2": "#808080",
    "white": "#ffffff",
    "white-25": "#ffffff40",
    "highlight": "#0070e0",
    "primary": "#0070e0",
    "primary-hover": "#0e86ff",
    "primary-press": "#0050a0",
    "secondary": "#383838",
    "foreground": "#c0c0c0",
    "foreground-hover": "#ffffff",
    "foreground-inverted": "#0f0f0f",
    "foreground-header": "#c8c8c8",
    "select": "#0070e0",
    "select-inactive": "#40576f",
    "select-parent": "#2c323a",
    "select-hover": "#242424",
    "notifications": "#464b50",
    "accent-blue": "#26bbff",
    "accent-purple": "#a139bf",
    "accent-pink": "#ff729c",
    "accent-red": "#ff4040",
    "accent-orange": "#fe9b07",
    "accent-yellow": "#ffdc1a",
    "accent-green": "#8bc24a",
    "accent-brown": "#804d39",
    "accent-black": "#242424",
    "accent-gray": "#808080",
    "accent-white": "#ffffff",
    "accent-folder": "#b68f55",
    "warning": "#ffb800",
    "error": "#ef3535",
    "success": "#1fe44b",
    "selection": "#18a0fb",
    "selection-pressed": "#da820a",
    "tab-hover": "#212121"
  }
}
