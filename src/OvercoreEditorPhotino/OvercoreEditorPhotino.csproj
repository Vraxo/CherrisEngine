<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OvercoreEditorPhotino</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Native WebView window (WebView2 / WKWebView / WebKitGTK) hosting the Blazor editor UI. -->
    <PackageReference Include="PhotinoX.Blazor" Version="5.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The render host, frame pipe and wire protocol are shared with the browser host. -->
    <ProjectReference Include="..\OvercoreEditorSession\OvercoreEditorSession.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Razor SDK already includes wwwroot as Content; only the copy behaviour is added here. -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shaders are resolved from <BaseDirectory>/EditorResources at runtime. -->
    <Content Include="..\OvercoreEditor\EditorResources\**\*"
             Link="EditorResources\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
