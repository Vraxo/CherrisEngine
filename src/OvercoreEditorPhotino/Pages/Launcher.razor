@page "/"
@inject EditorHostService Host
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Overcore Editor</PageTitle>

<div class="launcher">
    <aside class="launcher-nav">
        <div>
            <div class="launcher-brand">OVERCORE</div>
            <div class="launcher-caption">Project launcher</div>
        </div>

        <nav class="launcher-nav-items">
            <button type="button"
                    class="launcher-nav-item @(Tab == LauncherTab.Projects ? "active" : "")"
                    @onclick="() => SetTab(LauncherTab.Projects)">
                Projects
            </button>
            <button type="button"
                    class="launcher-nav-item @(Tab == LauncherTab.NewProject ? "active" : "")"
                    @onclick="() => SetTab(LauncherTab.NewProject)">
                + New project
            </button>
        </nav>

        <div class="launcher-nav-footer">
            <span>@_recent.Count recent @(_recent.Count == 1 ? "project" : "projects")</span>
            <span class="launcher-muted">Saved on this device</span>
            <button type="button" class="launcher-link" @onclick="OpenDemoAsync">Skip: demo scene</button>
        </div>
    </aside>

    <main class="launcher-main">
        <div class="launcher-column">
            <div class="launcher-caption">
                Workspace / @(Tab == LauncherTab.NewProject ? "New project" : "Projects")
            </div>
            <h1 class="launcher-headline">
                @(Tab == LauncherTab.NewProject ? "Make something new." : "Welcome back.")
            </h1>
            <p class="launcher-muted">
                @(Tab == LauncherTab.NewProject
                    ? "Give your next idea a folder of its own."
                    : "Pick up where you left off, or open a project folder.")
            </p>

            @if (_error is string error)
            {
                <div class="launcher-error" role="alert">
                    <strong>@(_busy ? "Working…" : "Could not complete that action")</strong>
                    <span>@error</span>
                </div>
            }

            @if (_busy)
            {
                <div class="launcher-busy">@_busyText</div>
            }

            @if (Tab == LauncherTab.Projects)
            {
                <section class="launcher-card">
                    <div class="launcher-card-header">
                        <span>Recent projects</span>
                        <span class="launcher-muted">@_recent.Count total</span>
                    </div>

                    <input class="launcher-input"
                           type="search"
                           placeholder="Search projects by name or path…"
                           @bind="_search"
                           @bind:event="oninput" />

                    @if (Matches.Count == 0)
                    {
                        <p class="launcher-muted">
                            @(_recent.Count == 0
                                ? "No projects yet — create one, or open an existing folder below."
                                : "No matching projects. Try a different name or path.")
                        </p>
                    }
                    else
                    {
                        <ul class="launcher-list">
                            @foreach (RecentProjectEntry entry in Matches)
                            {
                                <li class="launcher-row">
                                    <div class="launcher-row-text">
                                        <span class="launcher-row-title">
                                            @entry.Name
                                            <span class="launcher-badge @(entry.Exists ? "ready" : "missing")">
                                                @(entry.Exists ? "ready" : "missing")
                                            </span>
                                        </span>
                                        <span class="launcher-row-path" title="@entry.Path">@entry.Path</span>
                                    </div>
                                    <div class="launcher-row-actions">
                                        <button type="button"
                                                class="editor-button"
                                                disabled="@(_busy || !entry.Exists)"
                                                @onclick="() => OpenAsync(entry.Path)">
                                            Open
                                        </button>
                                        <button type="button"
                                                class="editor-button subtle"
                                                disabled="@_busy"
                                                @onclick="() => Forget(entry.Path)">
                                            Remove
                                        </button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="launcher-card">
                    <div class="launcher-card-header">
                        <span>Have a project already?</span>
                    </div>
                    <p class="launcher-muted">Select the folder that contains <code>project.yaml</code>.</p>

                    <div class="launcher-field">
                        <input class="launcher-input"
                               placeholder="Path to a project folder"
                               @bind="_openPath"
                               @bind:event="oninput" />
                        <button type="button" class="editor-button" disabled="@_busy" @onclick="BrowseOpenAsync">
                            Browse…
                        </button>
                    </div>

                    <div class="launcher-actions">
                        <button type="button"
                                class="editor-button primary"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_openPath))"
                                @onclick="() => OpenAsync(_openPath)">
                            Open project
                        </button>
                        @if (Host.FolderPicker is null)
                        {
                            <span class="launcher-muted">Type a path; the folder dialog is unavailable.</span>
                        }
                    </div>
                </section>

                <section class="launcher-card">
                    <div class="launcher-card-header">
                        <span>Built-in samples</span>
                    </div>
                    <p class="launcher-muted">Create a copy to explore; the bundled examples are never modified.</p>
                    @foreach (ProjectTemplate template in ProjectTemplateCatalog.Templates.Where(template => !template.IsBlank))
                    {
                        <div class="launcher-row">
                            <div class="launcher-row-text">
                                <span class="launcher-row-title">@template.Name</span>
                                <span class="launcher-row-path">@template.Description</span>
                            </div>
                            <button type="button"
                                    class="editor-button primary"
                                    disabled="@_busy"
                                    @onclick="() => StartFromTemplate(template)">
                                Create copy…
                            </button>
                        </div>
                    }
                </section>
            }
            else
            {
                <section class="launcher-card">
                    <div class="launcher-card-header">
                        <span>Project details</span>
                    </div>
                    <p class="launcher-muted">
                        @(_selectedTemplateId == ProjectTemplateCatalog.BlankId
                            ? "A new folder is created with project.yaml and an empty start scene."
                            : "A fresh copy of the selected sample is created; its bundled source remains unchanged.")
                    </p>

                    <label class="launcher-label" for="project-name">Project name</label>
                    <input id="project-name" class="launcher-input" @bind="_newProjectName" @bind:event="oninput" />

                    <label class="launcher-label" for="project-template">Template</label>
                    <select id="project-template" class="launcher-input" @bind="_selectedTemplateId">
                        @foreach (ProjectTemplate template in ProjectTemplateCatalog.Templates)
                        {
                            <option value="@template.Id">@template.Name</option>
                        }
                    </select>
                    <p class="launcher-muted">@(ProjectTemplateCatalog.Find(_selectedTemplateId)?.Description ?? "Choose a project template.")</p>

                    <label class="launcher-label" for="project-location">Location</label>
                    <div class="launcher-field">
                        <input id="project-location" class="launcher-input" @bind="_location" @bind:event="oninput" />
                        <button type="button" class="editor-button" disabled="@_busy" @onclick="BrowseLocationAsync">
                            Browse…
                        </button>
                    </div>

                    <div class="launcher-caption">Project folder</div>
                    <p class="launcher-muted launcher-path">@ProjectFolderPreview</p>

                    <div class="launcher-actions">
                        <button type="button" class="editor-button primary" disabled="@_busy" @onclick="CreateAsync">
                            Create project
                        </button>
                        <button type="button" class="editor-button" disabled="@_busy" @onclick="() => SetTab(LauncherTab.Projects)">
                            Cancel
                        </button>
                    </div>
                    <p class="launcher-muted">Existing folders are never overwritten.</p>
                </section>
            }
        </div>
    </main>
</div>
