@page "/editor"
@inject EditorHostService Host
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Host.SessionName — Overcore Editor</PageTitle>

@* Mirrors the ImGui editor's chrome: menu bar, centred transport toolbar, dockspace, status strip. *@
<div class="editor-shell">
    <MenuBar />
    <ToolBar />

    @if (Host.State == EditorSessionState.Failed)
    {
        <div class="editor-error">
            <h2>The editor host is not running</h2>
            <p>@(Host.FailureMessage ?? "The renderer stopped.")</p>

            @if (Host.FailureDetail is string detail)
            {
                <pre class="editor-error-detail">@detail</pre>
            }

            <div class="editor-error-actions">
                <button type="button" class="editor-button" @onclick="CopyDiagnostics">Copy diagnostics</button>
                <button type="button" class="editor-button" @onclick="BackToLauncher">Back to projects</button>
                @if (_copied)
                {
                    <span class="editor-error-confirm">copied to the clipboard</span>
                }
            </div>

            @if (Host.LogFilePath is string logPath)
            {
                <p class="editor-error-hint">Log file: <code>@logPath</code></p>
            }

            <h3>Host log</h3>
            <pre class="editor-log">@Host.LogTail(40)</pre>
        </div>
    }
    else if (Host.State == EditorSessionState.Starting)
    {
        <div class="editor-starting">Starting the renderer for @Host.SessionName…</div>
    }
    else
    {
        <div class="dockspace" id="dockspace">
            <div class="dock-pane">
                <HierarchyPanel />
            </div>

            <div class="dock-splitter dock-splitter-x" data-dock-splitter="1" data-axis="x" data-target="left"
                 role="separator" aria-orientation="vertical" title="Drag to resize the hierarchy"></div>

            <div class="dock-middle">
                <div class="dock-pane">
                    <ViewportPanel WebSocketUrl="@Host.WebSocketUrl" />
                </div>

                <div class="dock-splitter dock-splitter-y" data-dock-splitter="1" data-axis="y" data-target="bottom"
                     role="separator" aria-orientation="horizontal" title="Drag to resize the bottom dock"></div>

                <div class="dock-pane">
                    <section class="panel">
                        <header class="panel-tabstrip">
                            <button type="button" class="panel-tab @(_bottomTab == "content" ? "active" : "")"
                                    @onclick='() => _bottomTab = "content"'>
                                <i class="fa-solid fa-folder panel-tab-icon" aria-hidden="true"></i>Content Browser
                            </button>
                            <button type="button" class="panel-tab @(_bottomTab == "console" ? "active" : "")"
                                    @onclick='() => _bottomTab = "console"'>
                                <i class="fa-solid fa-terminal panel-tab-icon" aria-hidden="true"></i>Console
                            </button>
                        </header>

                        <div class="panel-body nopad">
                            @if (_bottomTab == "content")
                            {
                                <ContentBrowserPanel />
                            }
                            else
                            {
                                <ConsolePanel />
                            }
                        </div>
                    </section>
                </div>
            </div>

            <div class="dock-splitter dock-splitter-x" data-dock-splitter="1" data-axis="x" data-target="right"
                 role="separator" aria-orientation="vertical" title="Drag to resize the inspector"></div>

            <div class="dock-pane">
                <InspectorPanel />
            </div>
        </div>

        <StatusBar />
    }
</div>
