@inject EditorHostService Host
@inject SceneStore Store
@implements IDisposable

@* ImGui's transport toolbar: play/pause, stop and restart, three equal-width buttons, centred above the
   dockspace. Play is a toggle like ImGui's: the same button shows the pause glyph while the scene runs. *@
<div class="editor-toolbar-strip">
    <div class="transport" role="toolbar" aria-label="Play mode">
        <span class="transport-button" title="@PlayTitle">
            <button type="button" disabled="@(!CanPlay)" aria-label="@PlayLabel" @onclick="TogglePlayPause">
                @if (IsPlaying)
                {
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                        <rect x="4" y="3" width="3" height="10" />
                        <rect x="9" y="3" width="3" height="10" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.6 13 8l-8.5 5.4z" /></svg>
                }
            </button>
        </span>

        <span class="transport-button" title="@StopTitle">
            <button type="button" disabled="@(!CanStop)" aria-label="Stop" @onclick="StopPlayback">
                <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="3.5" width="9" height="9" /></svg>
            </button>
        </span>

        <span class="transport-button" title="@RestartTitle">
            <button type="button" disabled="@(!CanStop)" aria-label="Restart" @onclick="RestartPlayback">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 3.2a4.8 4.8 0 1 0 4.7 5.8" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <path d="M12.9 2.4v3.6H9.3z" />
                </svg>
            </button>
        </span>
    </div>
</div>
