@using Overcore.Scripting
@inject EditorHostService Host
@inject ScenePreviewStore Previews
@implements IDisposable

@* ImGui's Content Browser: <- Back and a path line, separator, then a grid of folders and assets. *@
<div class="content-browser">
    <div class="cb-header">
        <button type="button" class="imgui-button" disabled="@(_currentDirectory is null || IsAtRoot)"
                @onclick="GoBack" title="Go up one folder">
            &lt;- Back
        </button>

        <span class="cb-path" title="@_currentDirectory">Path: @DisplayPath</span>

        <span class="cb-count">@_entries.Count items</span>
    </div>

    <div class="imgui-separator"></div>

    <div class="cb-grid" title="Right-click to create a scene, script or folder"
         @oncontextmenu="(MouseEventArgs args) => OpenMenuAtPointer(args)" @oncontextmenu:preventDefault="true">
        @if (Host.ProjectRoot is null)
        {
            <p class="panel-empty">No project folder is open.</p>
        }
        else if (_entries.Count == 0)
        {
            <p class="panel-empty">This folder is empty. Right-click to create something in it.</p>
        }
        else
        {
            @foreach (Entry entry in _entries)
            {
                <button type="button" class="cb-item @(_selectedPath == entry.FullPath ? "selected" : "")"
                        title="@EntryTitle(entry)"
                        @onclick="() => Select(entry)"
                        @ondblclick="() => Activate(entry)"
                        @oncontextmenu="(MouseEventArgs args) => OpenMenu(args, entry)"
                        @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                    @if (Previews.Get(entry.FullPath) is SceneThumbnail preview)
                    {
                        <SceneThumbnailView Thumbnail="preview" />
                    }
                    else
                    {
                        @Glyph(entry)
                    }
                    <span class="cb-name">@entry.Name</span>
                </button>
            }
        }
    </div>
</div>

@if (_menuOpen)
{
    <div class="menu-scrim" @onclick="CloseMenu"></div>

    @* The menu hangs at the pointer, and the style clamps it to the window so a right-click near an edge does not
       open it off screen. *@
    <div class="menu-popup cb-menu" role="menu" style="@MenuStyle">
        @if (_menuTarget is Entry target)
        {
            @if (IsPrefab(target))
            {
                @* A prefab is not something to open: it is something to add to the scene. *@
                <button type="button" class="menu-item" role="menuitem"
                        title="Add one of this prefab to the scene" @onclick="() => InstantiateFromMenu(target)">
                    <span>Instantiate in Scene</span>
                </button>

                <div class="menu-separator"></div>
            }
            else if (target.IsDirectory || IsScene(target))
            {
                <button type="button" class="menu-item" role="menuitem" @onclick="() => ActivateFromMenu(target)">
                    <span>@(target.IsDirectory ? "Open Folder" : "Open Scene")</span>
                </button>

                <div class="menu-separator"></div>
            }
            @* A file that is neither a folder, a scene, nor a prefab has nothing honest to offer. *@
        }

        <button type="button" class="menu-item" role="menuitem" @onclick="() => BeginCreate(CreateKind.Scene)">
            <span>New Scene…</span>
        </button>

        <button type="button" class="menu-item" role="menuitem" disabled="@(!CanCreateScript)"
                title="@ScriptMenuTitle" @onclick="() => BeginCreate(CreateKind.Script)">
            <span>New Script…</span>
        </button>

        <button type="button" class="menu-item" role="menuitem" @onclick="() => BeginCreate(CreateKind.Folder)">
            <span>New Folder…</span>
        </button>

        <div class="menu-separator"></div>

        <button type="button" class="menu-item" role="menuitem" @onclick="RefreshFromMenu">
            <span>Refresh</span>
        </button>
    </div>
}

<NewItemDialog Visible="@(_dialogKind != CreateKind.None)"
               Title="@DialogTitle"
               Text="@DialogText"
               Label="@DialogLabel"
               DefaultName="@_dialogName"
               Choices="@LanguageChoices"
               Choice="@LanguageChoice"
               ChoiceChanged="@ChooseLanguage"
               Hint="@DialogHint"
               OnCreate="@CreateItem"
               OnClose="@CloseDialog" />
