@using Overcore.UI
@inject EditorHostService Host
@inject NavigationManager Nav
@inject ThemeService Themes
@inject IJSRuntime JS

@* ImGui's main menu bar: File / Edit / Window / Theme, drawn as flat text on the window background. *@
<div class="menubar" role="menubar">
    <button type="button" class="menubar-brand" title="Back to the project launcher" @onclick="OpenLauncher">
        Overcore Editor
    </button>

    <div class="menubar-item">
        <button type="button" class="menubar-button @(IsOpen("file") ? "open" : "")" aria-haspopup="menu"
                aria-expanded="@(IsOpen("file") ? "true" : "false")" @onclick='() => Toggle("file")'>
            File
        </button>

        @if (IsOpen("file"))
        {
            <div class="menu-popup" role="menu">
                <button type="button" class="menu-item" role="menuitem" @onclick="NewProject">
                    <span>New Project…</span>
                </button>
                <button type="button" class="menu-item" role="menuitem" @onclick="OpenLauncher">
                    <span>Open Project…</span>
                </button>
                <button type="button" class="menu-item" role="menuitem" disabled="@(!CanMakeScene)"
                        title="@NewSceneTitle" @onclick="OpenNewSceneDialog">
                    <span>New Scene…</span>
                </button>
                <button type="button" class="menu-item" role="menuitem" disabled="@(!CanReloadScripts)"
                        title="@ReloadScriptsTitle" @onclick="ReloadScripts">
                    <span>Reload Scripts</span>
                </button>
                <div class="menu-separator"></div>
                <button type="button" class="menu-item" role="menuitem" disabled
                        title="Saving is driven by the ImGui editor">
                    <span>Save</span>
                    <span class="menu-shortcut">Ctrl+S</span>
                </button>
                <div class="menu-separator"></div>
                <button type="button" class="menu-item" role="menuitem" disabled
                        title="Build options live in the ImGui editor">
                    <span>Pack Assets on Build</span>
                </button>
                <button type="button" class="menu-item" role="menuitem" disabled
                        title="Build options live in the ImGui editor">
                    <span>Build Game…</span>
                </button>
                <div class="menu-separator"></div>
                <button type="button" class="menu-item" role="menuitem" disabled="@(Host.CloseRequested is null)"
                        @onclick="Exit">
                    <span>Exit</span>
                </button>
            </div>
        }
    </div>

    <div class="menubar-item">
        <button type="button" class="menubar-button @(IsOpen("edit") ? "open" : "")" aria-haspopup="menu"
                aria-expanded="@(IsOpen("edit") ? "true" : "false")" @onclick='() => Toggle("edit")'>
            Edit
        </button>

        @if (IsOpen("edit"))
        {
            <div class="menu-popup" role="menu">
                <button type="button" class="menu-item" role="menuitem" disabled="@(!Host.CanUndo)"
                        title="@UndoTitle" @onclick="Undo">
                    <span>Undo</span>
                    <span class="menu-shortcut">Ctrl+Z</span>
                </button>
                <button type="button" class="menu-item" role="menuitem" disabled="@(!Host.CanRedo)"
                        title="@RedoTitle" @onclick="Redo">
                    <span>Redo</span>
                    <span class="menu-shortcut">Ctrl+Y</span>
                </button>
            </div>
        }
    </div>

    <div class="menubar-item">
        <button type="button" class="menubar-button @(IsOpen("window") ? "open" : "")" aria-haspopup="menu"
                aria-expanded="@(IsOpen("window") ? "true" : "false")" @onclick='() => Toggle("window")'>
            Window
        </button>

        @if (IsOpen("window"))
        {
            <div class="menu-popup" role="menu">
                <button type="button" class="menu-item" role="menuitem" @onclick="ResetLayout">
                    <span>Reset Layout</span>
                </button>
            </div>
        }
    </div>

    <div class="menubar-item">
        <button type="button" class="menubar-button @(IsOpen("theme") ? "open" : "")" aria-haspopup="menu"
                aria-expanded="@(IsOpen("theme") ? "true" : "false")" @onclick='() => Toggle("theme")'>
            Theme
        </button>

        @if (IsOpen("theme"))
        {
            <div class="menu-popup" role="menu">
                @foreach (EditorTheme theme in Themes.Catalog.Themes)
                {
                    <button type="button" class="menu-item" role="menuitemradio"
                            aria-checked="@(theme.Id == Themes.Active.Id)"
                            title="@theme.Provenance"
                            @onclick="() => SelectTheme(theme.Id)">
                        <span>@(theme.Id == Themes.Active.Id ? "\u2022 " : "")@theme.DisplayName</span>
                        @if (theme.IsExternal)
                        {
                            <span class="menu-shortcut">file</span>
                        }
                    </button>
                }

                <div class="menu-separator"></div>

                <button type="button" class="menu-item" role="menuitem" @onclick="ReloadThemes">
                    <span>Reload Themes</span>
                </button>

                @foreach ((string path, string error) in Themes.Errors)
                {
                    <button type="button" class="menu-item" role="menuitem" disabled title="@error">
                        <span>@System.IO.Path.GetFileName(path)</span>
                        <span class="menu-shortcut">error</span>
                    </button>
                }
            </div>
        }
    </div>

    <span class="menubar-spacer"></span>
    <span class="menubar-session" title="@Host.ProjectRoot">@SessionTitle</span>

    @if (_openMenu is not null)
    {
        <div class="menu-scrim" @onclick="CloseMenus"></div>
    }
</div>

@* The New Scene dialog belongs to the page, not to the menu bar it is opened from. *@
<NewItemDialog Visible="@_newSceneOpen"
               Title="New Scene"
               Text="A new scene starts with a camera and a sun, so it opens with something to look through and something to light it."
               Label="Scene name"
               DefaultName="@_newSceneName"
               Hint="@ScenePathHint"
               OnCreate="@CreateScene"
               OnClose="@CloseNewScene" />

@code {
    private string? _openMenu;
    private bool _newSceneOpen;
    private string _newSceneName = SceneTemplate.DefaultName;

    private string SessionTitle => Host.SessionName ?? "Overcore Editor";

    /// <summary>
    /// A scene is a file in a project and is opened by the running session, so both have to be there before the
    /// menu item can do anything.
    /// </summary>
    private bool CanMakeScene => Host.HasProject && Host.State == EditorSessionState.Running;

    /// <summary>
    /// A reload compiles the project's <c>Scripts/</c> folder inside the running session, which is the only place the
    /// scene and its component factories live — so the session has to be up.
    /// </summary>
    private bool CanReloadScripts => Host.State == EditorSessionState.Running;

    private string ReloadScriptsTitle => CanReloadScripts
        ? "Compile the project's Scripts folder again, so new and changed types are in the Add Component menu. A " +
            "component that is already attached keeps the code it was created with until its scene is opened again."
        : "The render session has to be running before its scripts can be compiled";

    private string NewSceneTitle => CanMakeScene
        ? "Create a scene file in this project and open it"
        : Host.HasProject
            ? "The render session has to be running before it can open a new scene"
            : "Open a project first: a scene is a file inside one";

    /// <summary>The file a typed name becomes, said before anything is written.</summary>
    private string ScenePathHint(string typed) =>
        ProjectFileName.TryPreview(Host.ProjectRoot, typed, SceneTemplate.Extension, out string path)
            ? $"Saves to {ProjectFileName.Describe(path, Host.ProjectRoot)}"
            : "Type a name to see the file it becomes.";

    private bool IsOpen(string menu) => _openMenu == menu;

    private void Toggle(string menu)
    {
        _openMenu = IsOpen(menu) ? null : menu;
    }

    private void CloseMenus()
    {
        _openMenu = null;
    }

    /// <summary>
    /// Asks the session to compile again. What came of it is in the console, where every other compile reports too:
    /// the count on success, and one line per error.
    /// </summary>
    private void ReloadScripts()
    {
        CloseMenus();
        Host.ReloadScripts();
    }

    private void OpenLauncher()
    {
        LeaveSession();
        Nav.NavigateTo("/");
    }

    private void NewProject()
    {
        LeaveSession();
        Nav.NavigateTo("/?tab=new");
    }

    // The launcher bounces back into the editor while a session is live, so picking a project has to end
    // this one first. Nothing in the web editor holds unsaved edits, so there is nothing to prompt about.
    private void LeaveSession()
    {
        CloseMenus();

        if (Host.State is not EditorSessionState.Idle)
        {
            Host.CloseSession();
        }
    }

    private void OpenNewSceneDialog()
    {
        CloseMenus();

        // The dialog opens on a name the project does not already use, so the common case is one keystroke.
        _newSceneName = Host.ProjectRoot is string root
            ? ProjectFileName.Available(root, SceneTemplate.DefaultName, SceneTemplate.Extension)
            : SceneTemplate.DefaultName;

        _newSceneOpen = true;
    }

    private void CloseNewScene() => _newSceneOpen = false;

    /// <summary>Creates the scene and opens it, or says why not — the dialog stays open until it works.</summary>
    private string? CreateScene(string name) =>
        Host.TryCreateScene(name, out string? error) ? null : error ?? "The scene could not be created.";

    private string UndoTitle => Host.UndoLabel is { } label ? "Undo " + label : "Nothing to undo";

    private string RedoTitle => Host.RedoLabel is { } label ? "Redo " + label : "Nothing to redo";

    private void Undo()
    {
        CloseMenus();
        Host.Undo();
    }

    private void Redo()
    {
        CloseMenus();
        Host.Redo();
    }

    private async Task SelectTheme(string id)
    {
        CloseMenus();

        try
        {
            await Themes.SelectAsync(JS, id);
        }
        catch (JSDisconnectedException)
        {
            // The window is closing; the selection is already saved.
        }

        StateHasChanged();
    }

    private async Task ReloadThemes()
    {
        CloseMenus();

        try
        {
            await Themes.ReloadAsync(JS);
        }
        catch (JSDisconnectedException)
        {
            // The window is closing; nothing to apply.
        }

        StateHasChanged();
    }

    private async Task ResetLayout()
    {
        CloseMenus();

        try
        {
            await JS.InvokeVoidAsync("overcoreDock.reset");
        }
        catch (JSDisconnectedException)
        {
            // The window is closing; there is nothing left to reset.
        }
    }

    private void Exit()
    {
        CloseMenus();
        Host.CloseRequested?.Invoke();
    }
}
