@using Overcore.UI
@inject EditorHostService Host
@inject NavigationManager Nav
@inject ThemeService Themes
@inject IJSRuntime JS

@* ImGui's main menu bar: File / Edit / Window / Theme, drawn as flat text on the window background. *@
<div class="menubar" role="menubar">
    <button type="button" class="menubar-brand" title="Back to the project launcher" @onclick="OpenLauncher">
        Overcore Editor
    </button>

    <div class="menubar-item">
        <button type="button" class="menubar-button @(IsOpen("file") ? "open" : "")" aria-haspopup="menu"
                aria-expanded="@(IsOpen("file") ? "true" : "false")" @onclick='() => Toggle("file")'>
            File
        </button>

        @if (IsOpen("file"))
        {
            <div class="menu-popup" role="menu">
                <button type="button" class="menu-item" role="menuitem" @onclick="NewProject">
                    <span>New Project…</span>
                </button>
                <button type="button" class="menu-item" role="menuitem" @onclick="OpenLauncher">
                    <span>Open Project…</span>
                </button>
                <button type="button" class="menu-item" role="menuitem" disabled="@(!CanMakeScene)"
                        title="@NewSceneTitle" @onclick="OpenNewSceneDialog">
                    <span>New Scene…</span>
                </button>
                <button type="button" class="menu-item" role="menuitem" disabled="@(!CanReloadScripts)"
                        title="@ReloadScriptsTitle" @onclick="ReloadScripts">
                    <span>Reload Scripts</span>
                </button>
                <div class="menu-separator"></div>
                <button type="button" class="menu-item" role="menuitem" disabled
                        title="Saving is driven by the ImGui editor">
                    <span>Save</span>
                    <span class="menu-shortcut">Ctrl+S</span>
                </button>
                <div class="menu-separator"></div>
                <button type="button" class="menu-item" role="menuitem" disabled
                        title="Build options live in the ImGui editor">
                    <span>Pack Assets on Build</span>
                </button>
                <button type="button" class="menu-item" role="menuitem" disabled
                        title="Build options live in the ImGui editor">
                    <span>Build Game…</span>
                </button>
                <div class="menu-separator"></div>
                <button type="button" class="menu-item" role="menuitem" disabled="@(Host.CloseRequested is null)"
                        @onclick="Exit">
                    <span>Exit</span>
                </button>
            </div>
        }
    </div>

    <div class="menubar-item">
        <button type="button" class="menubar-button @(IsOpen("edit") ? "open" : "")" aria-haspopup="menu"
                aria-expanded="@(IsOpen("edit") ? "true" : "false")" @onclick='() => Toggle("edit")'>
            Edit
        </button>

        @if (IsOpen("edit"))
        {
            <div class="menu-popup" role="menu">
                <button type="button" class="menu-item" role="menuitem" disabled="@(!Host.CanUndo)"
                        title="@UndoTitle" @onclick="Undo">
                    <span>Undo</span>
                    <span class="menu-shortcut">Ctrl+Z</span>
                </button>
                <button type="button" class="menu-item" role="menuitem" disabled="@(!Host.CanRedo)"
                        title="@RedoTitle" @onclick="Redo">
                    <span>Redo</span>
                    <span class="menu-shortcut">Ctrl+Y</span>
                </button>
            </div>
        }
    </div>

    <div class="menubar-item">
        <button type="button" class="menubar-button @(IsOpen("window") ? "open" : "")" aria-haspopup="menu"
                aria-expanded="@(IsOpen("window") ? "true" : "false")" @onclick='() => Toggle("window")'>
            Window
        </button>

        @if (IsOpen("window"))
        {
            <div class="menu-popup" role="menu">
                <button type="button" class="menu-item" role="menuitem" @onclick="ResetLayout">
                    <span>Reset Layout</span>
                </button>
            </div>
        }
    </div>

    <div class="menubar-item">
        <button type="button" class="menubar-button @(IsOpen("theme") ? "open" : "")" aria-haspopup="menu"
                aria-expanded="@(IsOpen("theme") ? "true" : "false")" @onclick='() => Toggle("theme")'>
            Theme
        </button>

        @if (IsOpen("theme"))
        {
            <div class="menu-popup" role="menu">
                @foreach (EditorTheme theme in Themes.Catalog.Themes)
                {
                    <button type="button" class="menu-item" role="menuitemradio"
                            aria-checked="@(theme.Id == Themes.Active.Id)"
                            title="@theme.Provenance"
                            @onclick="() => SelectTheme(theme.Id)">
                        <span>@(theme.Id == Themes.Active.Id ? "\u2022 " : "")@theme.DisplayName</span>
                        @if (theme.IsExternal)
                        {
                            <span class="menu-shortcut">file</span>
                        }
                    </button>
                }

                <div class="menu-separator"></div>

                <button type="button" class="menu-item" role="menuitem" @onclick="ReloadThemes">
                    <span>Reload Themes</span>
                </button>

                @foreach ((string path, string error) in Themes.Errors)
                {
                    <button type="button" class="menu-item" role="menuitem" disabled title="@error">
                        <span>@System.IO.Path.GetFileName(path)</span>
                        <span class="menu-shortcut">error</span>
                    </button>
                }
            </div>
        }
    </div>

    <span class="menubar-spacer"></span>
    <span class="menubar-session" title="@Host.ProjectRoot">@SessionTitle</span>

    @if (_openMenu is not null)
    {
        <div class="menu-scrim" @onclick="CloseMenus"></div>
    }
</div>

@* The New Scene dialog belongs to the page, not to the menu bar it is opened from. *@
<NewItemDialog Visible="@_newSceneOpen"
               Title="New Scene"
               Text="A new scene starts with a camera and a sun, so it opens with something to look through and something to light it."
               Label="Scene name"
               DefaultName="@_newSceneName"
               Hint="@ScenePathHint"
               OnCreate="@CreateScene"
               OnClose="@CloseNewScene" />
