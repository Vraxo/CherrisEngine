@using LogLevel = Overcore.Core.LogLevel
@inject EditorHostService Host
@inject IJSRuntime JS
@implements IDisposable

@* ImGui's Console: Clear + Auto-scroll, separator, then colour-coded log lines. *@
<div class="console">
    <div class="console-toolbar">
        <button type="button" class="imgui-button" @onclick="Clear">Clear</button>

        <label class="imgui-checkbox">
            <input type="checkbox" @bind="_autoScroll" />
            <span>Auto-scroll</span>
        </label>

        <span class="console-count">@_entries.Count lines</span>
    </div>

    <div class="imgui-separator"></div>

    <div class="console-log" id="console-log">
        @if (_entries.Count == 0)
        {
            <p class="panel-empty">Nothing logged yet.</p>
        }
        else
        {
            @foreach (EditorLogEntry entry in _entries)
            {
                <div class="log-line @LevelClass(entry.Level)">
                    <span class="log-time">[@entry.Timestamp.ToString("HH:mm:ss")]</span>
                    <span class="log-level">[@entry.Level]</span>
                    <span class="log-text">@entry.Message</span>
                </div>
            }
        }
    </div>
</div>
