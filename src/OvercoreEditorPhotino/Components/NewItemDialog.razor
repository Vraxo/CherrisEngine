@* One dialog for everything the editor creates: a name, the file it becomes, and the reason when it is refused.
   The parent decides what creating means, so the File menu and the content browser share this instead of each
   growing a copy of it. *@
@if (Visible)
{
    <div class="dialog-scrim" @onclick="Close"></div>

    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="@TitleId">
        <h2 class="dialog-title" id="@TitleId">@Title</h2>

        <p class="dialog-text">@Text</p>

        @if (Choices is { Count: > 1 })
        {
            @* Only the dialogs that can make more than one thing show this — today a script is Lua or C#. The parent
               owns the choice, so it can read it back when Create is pressed. *@
            <div class="dialog-choices" role="group" aria-label="Language">
                @foreach (string choice in Choices)
                {
                    string buttonClass = IsChosen(choice) ? "editor-button primary" : "editor-button";
                    string pressed = IsChosen(choice) ? "true" : "false";

                    <button type="button" class="@buttonClass" aria-pressed="@pressed"
                            @onclick="() => Choose(choice)">
                        @choice
                    </button>
                }
            </div>
        }

        <label class="dialog-label" for="@InputId">@Label</label>
        <input id="@InputId" class="dialog-input" @ref="_input" spellcheck="false"
               @bind="_name" @bind:event="oninput" @onkeydown="OnKeyDown" />

        @if (Hint is not null)
        {
            <p class="dialog-hint">@Hint(_name)</p>
        }

        @if (_error is string error)
        {
            <p class="dialog-error" role="alert">@error</p>
        }

        <div class="dialog-actions">
            <button type="button" class="editor-button primary" @onclick="Submit">Create</button>
            <button type="button" class="editor-button" @onclick="Close">Cancel</button>
        </div>
    </div>
}
