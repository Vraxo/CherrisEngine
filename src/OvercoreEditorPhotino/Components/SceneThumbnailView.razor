@using System.Globalization
@using System.Numerics

@* A scene preview: a top-down map of where the scene's objects are, drawn from the scene file alone. *@
<svg class="cb-thumb" viewBox="0 0 @Width @Height" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <rect class="cb-thumb-floor" x="0" y="0" width="@Width" height="@Height" rx="1" />

    @if (Thumbnail.IsEmpty)
    {
        <rect class="cb-thumb-empty" x="6" y="6" width="@(Width - 12)" height="@(Height - 12)" rx="2" />
    }
    else
    {
        @foreach (ThumbnailShape shape in _shapes)
        {
            switch (shape.Kind)
            {
                case ThumbnailObjectKind.Mesh:
                    <rect class="cb-thumb-mesh" x="@Units(shape.X - (shape.Width / 2f))"
                          y="@Units(shape.Y - (shape.Height / 2f))" width="@Units(shape.Width)"
                          height="@Units(shape.Height)" rx="1" transform="@Turn(shape)" />
                    break;

                case ThumbnailObjectKind.Camera:
                    <polygon class="cb-thumb-camera" points="@CameraPoints(shape)" />
                    break;

                case ThumbnailObjectKind.Light:
                    <circle class="cb-thumb-light-glow" cx="@Units(shape.X)" cy="@Units(shape.Y)"
                            r="@Units(shape.Width * 0.62f)" />
                    <circle class="cb-thumb-light" cx="@Units(shape.X)" cy="@Units(shape.Y)"
                            r="@Units(shape.Width * 0.26f)" />
                    break;

                default:
                    <rect class="cb-thumb-other" x="@Units(shape.X - (shape.Width / 2f))"
                          y="@Units(shape.Y - (shape.Height / 2f))" width="@Units(shape.Width)"
                          height="@Units(shape.Height)" rx="1" transform="@Turn(shape)" />
                    break;
            }
        }
    }
</svg>
