@* ImGui's transport toolbar: three equal-width buttons, centred, above the dockspace. *@
<div class="editor-toolbar-strip">
    <div class="transport" role="toolbar" aria-label="Play mode">
        <span class="transport-button" title="Play — play mode is driven by the ImGui editor">
            <button type="button" disabled aria-label="Play">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.6 13 8l-8.5 5.4z" /></svg>
            </button>
        </span>

        <span class="transport-button" title="Pause — play mode is driven by the ImGui editor">
            <button type="button" disabled aria-label="Pause">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                    <rect x="4" y="3" width="3" height="10" />
                    <rect x="9" y="3" width="3" height="10" />
                </svg>
            </button>
        </span>

        <span class="transport-button" title="Stop — nothing is running to stop">
            <button type="button" disabled aria-label="Stop">
                <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="3.5" width="9" height="9" /></svg>
            </button>
        </span>

        <span class="transport-button" title="Restart — play mode is driven by the ImGui editor">
            <button type="button" disabled aria-label="Restart">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 3.2a4.8 4.8 0 1 0 4.7 5.8" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <path d="M12.9 2.4v3.6H9.3z" />
                </svg>
            </button>
        </span>
    </div>
</div>
