@inject SceneStore Store
@inject SceneSelection Selection
@implements IDisposable

@* ImGui's Inspector: object name, Transform, then one collapsible section per component. *@
<section class="panel">
    <header class="panel-tabstrip">
        <span class="panel-tab active">Inspector</span>
    </header>

    <div class="panel-body">
        @if (SelectedNode is not SceneNodeSnapshot node)
        {
            <p class="panel-empty">No object selected.</p>
        }
        else
        {
            <input type="text" class="imgui-input" value="@node.Name" readonly
                   aria-label="Object name" title="Renaming is driven by the ImGui editor" />

            <div class="imgui-separator"></div>

            <div class="inspector-section">
                <div class="inspector-section-header">
                    <span class="tree-arrow">
                        <svg class="tree-chevron expanded" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.4"
                                  stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span>Transform</span>
                </div>

                @* One row per Vector3, each component labelled with its axis the way the ImGui inspector
                   does: X red, Y green, Z blue. Rotation is shown as Euler degrees, so all three rows read
                   the same. *@
                <div class="inspector-section-body">
                    @foreach (TransformRow row in TransformRows.From(node))
                    {
                        <div class="vec-row">
                            <span class="vec-label">@row.Label</span>

                            <div class="vec-fields">
                                @* Strings are built as locals: an attribute cannot hold a C# string literal
                                   without its own quotes ending the attribute. *@
                                @for (int axis = 0; axis < row.Components.Count; axis++)
                                {
                                    string letter = TransformRow.Axes[axis];
                                    string axisClass = "vec-axis axis-" + letter.ToLowerInvariant();
                                    string text = row.Components[axis].ToString("0.###", CultureInfo.InvariantCulture);
                                    string fieldName = row.Label + " " + letter;

                                    <span class="vec-cell">
                                        <span class="@axisClass">@letter</span>
                                        <input type="text" class="imgui-input vec-field" value="@text"
                                               readonly tabindex="-1" aria-label="@fieldName" />
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @foreach (string component in node.Components)
            {
                <div class="inspector-section">
                    <div class="inspector-section-header">
                        <span class="tree-arrow">
                            <svg class="tree-chevron expanded" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor"
                                      stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                        <span>@component</span>
                    </div>

                    <div class="inspector-section-body">
                        <p class="inspector-muted">Fields are edited in the ImGui editor.</p>
                    </div>
                </div>
            }

            <div class="inspector-add">
                <button type="button" class="imgui-button" disabled title="Components are added in the ImGui editor">
                    Add ▾
                </button>
            </div>
        }
    </div>
</section>

@code {
    private SceneNodeSnapshot? SelectedNode
    {
        get
        {
            if (Selection.SelectedId is not Guid id || Store.Current is not SceneSnapshot scene)
            {
                return null;
            }

            return scene.Nodes.FirstOrDefault(node => node.Id == id);
        }
    }

    protected override void OnInitialized()
    {
        Store.Changed += OnSceneChanged;
        Selection.Changed += OnSceneChanged;
    }

    private void OnSceneChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Store.Changed -= OnSceneChanged;
        Selection.Changed -= OnSceneChanged;
    }
}
