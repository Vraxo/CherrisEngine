@using Cherris.Components
@using CherrisEditorWeb
@using CherrisEditorWeb.Host
@using Cherris.Scripting
@inject SceneStore Store
@inject SceneSelection Selection
@inject EditorHostService Host
@implements IDisposable

@* ImGui's Inspector: object name, Transform, then one collapsible section per component. Fields are live:
   an edit is queued for the render thread, and the next snapshot shows the result. *@
<section class="panel">
    <header class="panel-tabstrip">
        <span class="panel-tab active">Inspector</span>
    </header>

    <div class="panel-body">
        @if (SelectedNode is not SceneNodeSnapshot node)
        {
            <p class="panel-empty">No object selected.</p>
        }
        else
        {
            string nameKey = node.Id.ToString() + ":name";

            <input type="text" class="imgui-input" value="@node.Name" disabled="@(!CanEdit)"
                   @key="KeyFor(nameKey)" aria-label="Object name" title="Rename this object"
                   @onchange="e => Rename(node, e.Value?.ToString())" />

            <div class="imgui-separator"></div>

            <div class="inspector-section">
                <div class="inspector-section-header">
                    <span class="tree-arrow">
                        <svg class="tree-chevron expanded" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.4"
                                  stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span>Transform</span>
                </div>

                @* One row per Vector3, each component labelled with its axis the way the ImGui inspector
                   does: X red, Y green, Z blue. Rotation is shown as Euler degrees, so all three rows read
                   the same. *@
                <div class="inspector-section-body">
                    @foreach (TransformRow row in TransformRows.From(node))
                    {
                        <div class="vec-row">
                            <span class="vec-label">@row.Label</span>

                            <div class="vec-fields">
                                @* Strings are built as locals: an attribute cannot hold a C# string literal
                                   without its own quotes ending the attribute. *@
                                @for (int axis = 0; axis < row.Components.Count; axis++)
                                {
                                    string letter = TransformRow.Axes[axis];
                                    string axisClass = "vec-axis axis-" + letter.ToLowerInvariant();
                                    string text = Format(row.Components[axis]);
                                    string fieldName = row.Label + " " + letter;
                                    string fieldKey = node.Id.ToString() + ":transform." + row.Field + "." + letter;
                                    int axisIndex = axis;

                                    <span class="vec-cell">
                                        <span class="@axisClass">@letter</span>
                                        @* Dragging scrubs at 0.1 per pixel, the speed TransformInspector's
                                           DragFloat uses, and the object follows every frame; a click without
                                           movement still types. The drag script sends an input event when a drag
                                           begins and a change per frame while it runs, so oninput ending the live
                                           session is what keeps each drag, and each typed value, its own undo step. *@
                                        <input type="text" class="imgui-input vec-field drag-number"
                                               value="@text" data-value="@text" data-speed="0.1"
                                               @key="KeyFor(fieldKey)" disabled="@(!CanEdit)" aria-label="@fieldName"
                                               @onchange="e => OnTransformChanged(node, row, axisIndex, e.Value?.ToString())"
                                               @oninput="EndLiveEdit"
                                               @onblur="() => Blurred(fieldKey)" />
                                    </span>
                                }
                            </div>

                            @* Position, rotation and scale each go back to what a new object has: zero,
                               the identity and one. *@
                            <ResetButton CanReset="@(CanEdit && row.CanReset)" Default="@row.DefaultText"
                                         Label="@row.Label"
                                         OnReset="() => ResetTransform(node.Id, row)" />
                        </div>
                    }
                </div>
            </div>

            @foreach (ComponentSnapshot component in node.Components)
            {
                <div class="inspector-section">
                    <div class="inspector-section-header">
                        <span class="tree-arrow">
                            <svg class="tree-chevron expanded" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor"
                                      stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                        <span>@component.TypeName</span>
                    </div>

                    <div class="inspector-section-body">
                        @if (component.Properties.Count == 0)
                        {
                            <p class="inspector-muted">Nothing on this component is editable yet.</p>
                        }
                        else
                        {
                            @foreach (PropertySnapshot property in component.Properties)
                            {
                                string propertyKey = PropertyKey(node, component, property);

                                <div class="prop-row">
                                    <span class="prop-label" title="@property.Name">@property.Name</span>

                                    @* The value column keeps its width whether or not the button is usable, so
                                       the editors line up down the component. *@
                                    <div class="prop-value">
                                        @switch (property.Kind)
                                        {
                                            case PropertyKind.Boolean:
                                                <input type="checkbox" class="imgui-check" checked="@property.IsOn"
                                                       disabled="@(!CanEdit)" aria-label="@property.Name"
                                                       @onchange="e => OnPropertyChanged(node, component, property, e.Value?.ToString())" />
                                                break;

                                            case PropertyKind.Choice:
                                                <select class="imgui-input imgui-select" disabled="@(!CanEdit)"
                                                        aria-label="@property.Name"
                                                        @onchange="e => OnPropertyChanged(node, component, property, e.Value?.ToString())">
                                                    @foreach (string choice in property.Choices)
                                                    {
                                                        <option value="@choice" selected="@(choice == property.Text)">@choice</option>
                                                    }
                                                </select>
                                                break;

                                            case PropertyKind.Number:
                                                @if (property.HasBoundedRange && property.Minimum is float minimum
                                                     && property.Maximum is float maximum)
                                                {
                                                    @* A range input reports every step while the thumb moves
                                                       and once more when it is released, which is exactly a drag
                                                       and its end. *@
                                                    <input type="range" class="imgui-slider" disabled="@(!CanEdit)"
                                                           aria-label="@property.Name"
                                                           min="@Format(minimum)" max="@Format(maximum)" step="any"
                                                           value="@Format(property.Components[0])"
                                                           @oninput="e => OnPropertyDragged(node, component, property, e.Value?.ToString())"
                                                           @onchange="EndLiveEdit" />
                                                }
                                                <input type="text" class="imgui-input drag-number"
                                                       value="@property.Text"
                                                       data-value="@property.Text"
                                                       data-speed="@Format(property.DragSpeed)"
                                                       data-min="@RangeText(property.Minimum)"
                                                       data-max="@RangeText(property.Maximum)"
                                                       @key="KeyFor(propertyKey)"
                                                       disabled="@(!CanEdit)" aria-label="@property.Name"
                                                       @onchange="e => OnPropertyDragged(node, component, property, e.Value?.ToString())"
                                                       @oninput="EndLiveEdit"
                                                       @onblur="() => Blurred(propertyKey)" />
                                                break;

                                            case PropertyKind.Integer:
                                                <input type="text" class="imgui-input drag-number"
                                                       value="@property.Text"
                                                       data-value="@property.Text"
                                                       data-speed="@Format(property.DragSpeed)"
                                                       data-integer="true"
                                                       data-min="@RangeText(property.Minimum)"
                                                       data-max="@RangeText(property.Maximum)"
                                                       @key="KeyFor(propertyKey)"
                                                       disabled="@(!CanEdit)" aria-label="@property.Name"
                                                       @onchange="e => OnPropertyDragged(node, component, property, e.Value?.ToString())"
                                                       @oninput="EndLiveEdit"
                                                       @onblur="() => Blurred(propertyKey)" />
                                                break;

                                            case PropertyKind.Text:
                                                <input type="text" class="imgui-input" value="@property.Text"
                                                       @key="KeyFor(propertyKey)"
                                                       disabled="@(!CanEdit)" aria-label="@property.Name"
                                                       @onchange="e => OnPropertyChanged(node, component, property, e.Value?.ToString())" />
                                                break;

                                            case PropertyKind.Vector2:
                                            case PropertyKind.Vector3:
                                                @if (property.IsColor)
                                                {
                                                    <input type="color" class="colour-swatch" disabled="@(!CanEdit)"
                                                           aria-label="@property.Name"
                                                           value="@Hex(property.Components)"
                                                           @onchange="e => OnColourChanged(node, component, property, e.Value?.ToString())" />
                                                }
                                                <span class="prop-vec">
                                                    @for (int axis = 0; axis < property.Components.Count; axis++)
                                                    {
                                                        string letter = TransformRow.Axes[axis];
                                                        string axisClass = "vec-axis axis-" + letter.ToLowerInvariant();
                                                        string fieldName = property.Name + " " + letter;
                                                        string fieldKey = propertyKey + "." + letter;
                                                        // A colour component has no floor of its own; ImGui's
                                                        // ColorEdit holds it at 0 and lets HDR go past 1.
                                                        string floorBound = property.IsColor ? "0" : string.Empty;
                                                        int axisIndex = axis;

                                                        <span class="vec-cell">
                                                            <span class="@axisClass">@letter</span>
                                                            <input type="text" class="imgui-input vec-field drag-number"
                                                                   value="@Format(property.Components[axis])"
                                                                   data-value="@Format(property.Components[axis])"
                                                                   data-speed="@Format(property.DragSpeed)"
                                                                   data-min="@floorBound"
                                                                   @key="KeyFor(fieldKey)" disabled="@(!CanEdit)"
                                                                   aria-label="@fieldName"
                                                                   @onchange="e => OnVectorChanged(node, component, property, axisIndex, e.Value?.ToString())"
                                                                   @oninput="EndLiveEdit"
                                                                   @onblur="() => Blurred(fieldKey)" />
                                                        </span>
                                                    }
                                                </span>
                                                break;
                                        }
                                    </div>

                                    <ResetButton CanReset="@(CanEdit && property.CanReset)"
                                                 Default="@property.DefaultText" Label="@property.Name"
                                                 OnReset="() => ResetProperty(node, component, property)" />
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            <div class="inspector-add">
                <button type="button" class="imgui-button" disabled="@(!CanEdit)" title="@AddTitle"
                        @onclick="() => ToggleAddMenu(node.Id)">
                    Add Component
                </button>

                @if (IsAddMenuOpen(node.Id))
                {
                    @* The menu is inline — it scrolls with the panel rather than floating over it — so it carries its
                       own click-away: any click that is not on the menu closes it, the same way the menubar's menus
                       do. The menu is lifted over the scrim in app.css, or the scrim would cover it too. *@
                    <div class="add-menu-scrim" @onclick="CloseAddMenu"></div>

                    IReadOnlyList<ComponentCatalog.Entry> matches = Matches(node);
                    string query = _search.Trim();
                    bool suggestScript = query.Length > 0 && matches.Count == 0;
                    string? scriptName = ScriptTemplate.Normalize(query);

                    @* The list opens inline: the panel body scrolls, so a floating menu would be clipped by
                       its own scroll container. The search box takes the focus, so the menu is usable from the
                       keyboard: type to filter, Enter for the top row, Escape to close. *@
                    <div class="add-menu" role="menu">
                        <input type="text" class="imgui-input add-search" value="@_search"
                               placeholder="Search components…" aria-label="Search components"
                               autocomplete="off" spellcheck="false" @ref="_searchBox"
                               @oninput="e => Search(e.Value?.ToString())"
                               @onkeydown="OnSearchKeyDown" />

                        @if (matches.Count > 0)
                        {
                            @foreach (ComponentCatalog.Entry entry in matches)
                            {
                                <button type="button" class="menu-item" role="menuitem"
                                        @onclick="() => AddComponent(node, entry)">
                                    <span>@entry.DisplayName</span>
                                </button>
                            }
                        }
                        else if (suggestScript)
                        {
                            @* The name matched nothing, so offer to make it a script — the way Unity's
                               Add Component menu does. *@
                            <button type="button" class="menu-item add-script" role="menuitem"
                                    disabled="@(!CanAddScript() || scriptName is null)"
                                    title="@ScriptTitle(query, scriptName)"
                                    @onclick="() => AddScript(node)">
                                <span>@ScriptLabel(query, scriptName)</span>
                            </button>
                        }
                        else
                        {
                            <p class="panel-empty">This object already has every component there is.</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private Guid? _addMenuFor;
    private string _search = string.Empty;
    private ElementReference _searchBox;
    private bool _focusSearch;

    private SceneNodeSnapshot? SelectedNode
    {
        get
        {
            if (Selection.SelectedId is not Guid id || Store.Current is not SceneSnapshot scene)
            {
                return null;
            }

            return scene.Nodes.FirstOrDefault(node => node.Id == id);
        }
    }

    /// <summary>True while a session is running to apply an edit to.</summary>
    private bool CanEdit => Host.State == EditorSessionState.Running;

    private HashSet<string> _editedFields = [];
    private int _editRevision;

    /// <summary>
    /// The key of a field: the field's own id, except for the one an edit came from, which changes so Blazor
    /// rebuilds it when the next snapshot arrives. That is how a refused value goes back to what the engine
    /// actually holds — an input's <c>value</c> attribute alone cannot, because the value it would be set back
    /// to is the one already in the render tree. Only the edited field is rebuilt, so nothing else loses focus.
    /// </summary>
    private string KeyFor(string field) => _editedFields.Contains(field)
        ? field + "#" + _editRevision.ToString(CultureInfo.InvariantCulture)
        : field;

    /// <summary>
    /// Makes the named fields new elements on the next render, so the snapshot's value shows even when the
    /// element holds text the author typed. The revision in each key is what makes them new.
    /// </summary>
    /// <param name="fields">Field keys, the same ones <see cref="KeyFor"/> is given.</param>
    private void Touched(params string[] fields)
    {
        _editedFields = [.. fields];
        _editRevision++;
    }

    private static string PropertyKey(SceneNodeSnapshot node, ComponentSnapshot component, PropertySnapshot property) =>
        node.Id.ToString() + ":" + component.TypeName + "." + property.Name;

    private string AddTitle => CanEdit
        ? "Add a component to this object"
        : "No render session is running";

    private bool IsAddMenuOpen(Guid objectId) => CanEdit && _addMenuFor == objectId;

    private void ToggleAddMenu(Guid objectId)
    {
        if (IsAddMenuOpen(objectId))
        {
            CloseAddMenu();
            return;
        }

        if (!CanEdit)
        {
            return;
        }

        _addMenuFor = objectId;
        _search = string.Empty;

        // The box does not exist until the menu has rendered, so the focus is taken after the render.
        _focusSearch = true;
    }

    private void CloseAddMenu()
    {
        _addMenuFor = null;
        _search = string.Empty;
        _focusSearch = false;
    }

    /// <summary>
    /// A number field lost the focus: the drag is over, so the next edit starts its own undo step, and the field
    /// is rebuilt from the snapshot — which is what puts a refused value back to what the engine holds.
    /// </summary>
    private void Blurred(string field)
    {
        Host.EndLiveEdit();
        Touched(field);
    }

    /// <summary>Ends a drag without rebuilding: a keystroke means the next typed value is its own step.</summary>
    private void EndLiveEdit() => Host.EndLiveEdit();

    /// <summary>
    /// Puts a property back to the value a freshly constructed component of its type has — the same default the
    /// ImGui inspector's reset button restores. It is an ordinary edit, so it undoes in one step.
    /// </summary>
    /// <param name="node">The object that owns the component.</param>
    /// <param name="component">The component.</param>
    /// <param name="property">The property to put back.</param>
    private void ResetProperty(
        SceneNodeSnapshot node, ComponentSnapshot component, PropertySnapshot property)
    {
        if (property.DefaultText is not { } text)
        {
            return;
        }

        Host.SetProperty(node.Id, component.TypeName, property.Name, text);

        if (property.Kind is not (PropertyKind.Vector2 or PropertyKind.Vector3))
        {
            Touched(PropertyKey(node, component, property));
            return;
        }

        // A vector is one key per axis, so every component has to be rebuilt, not just the first.
        string propertyKey = PropertyKey(node, component, property);
        string[] axes = [.. TransformRow.Axes.Take(property.Components.Count)
            .Select(axis => propertyKey + "." + axis)];

        Touched(axes);
    }

    /// <summary>Puts a transform row back to zero, the identity or one: what a new object starts with.</summary>
    /// <param name="objectId">The object to move.</param>
    /// <param name="row">The row the button belongs to.</param>
    private void ResetTransform(Guid objectId, TransformRow row)
    {
        if (!row.CanReset)
        {
            return;
        }

        Host.SetTransform(objectId, row.Field, row.Default.X, row.Default.Y, row.Default.Z);

        string prefix = objectId.ToString() + ":transform." + row.Field + ".";
        string[] axes = [.. TransformRow.Axes.Select(axis => prefix + axis)];

        Touched(axes);
    }

    private void Search(string? text)
    {
        _search = text ?? string.Empty;
    }

    /// <summary>The entries this object could take whose name contains the search text.</summary>
    private IReadOnlyList<ComponentCatalog.Entry> Matches(SceneNodeSnapshot node)
    {
        string query = _search.Trim();

        return AddableTypes(node)
            .Where(entry => query.Length == 0 ||
                entry.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    /// <summary>True when the typed name could become a script the render thread would write into the project.</summary>
    private bool CanAddScript() => CanEdit && Host.HasProject;

    private string ScriptLabel(string query, string? scriptName) => scriptName is null
        ? "New script: \"" + query + "\""
        : Host.ScriptExists(scriptName)
            ? "Script: \"" + scriptName + "\" (already in this project)"
            : "New script: \"" + scriptName + "\"";

    private string ScriptTitle(string query, string? scriptName)
    {
        if (scriptName is null)
        {
            return $"\"{query}\" cannot name a script: start with a letter or underscore, then use letters, " +
                "digits and underscores.";
        }

        if (!Host.HasProject)
        {
            return "Open a project to create scripts: they live in the project's Scripts folder.";
        }

        return Host.ScriptExists(scriptName)
            ? "Attach the existing " + ScriptTemplate.RelativePath(scriptName) + " to this object."
            : "Create " + ScriptTemplate.RelativePath(scriptName) + " with an empty start() and update(), " +
                "then attach it to this object.";
    }

    /// <summary>Enter takes the first match, or the script suggestion when nothing matched; Escape closes.</summary>
    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseAddMenu();
            return;
        }

        if (e.Key != "Enter" || SelectedNode is not { } node || !IsAddMenuOpen(node.Id))
        {
            return;
        }

        IReadOnlyList<ComponentCatalog.Entry> matches = Matches(node);

        if (matches.Count > 0)
        {
            AddComponent(node, matches[0]);
        }
        else if (CanAddScript() && ScriptTemplate.Normalize(_search) is not null)
        {
            AddScript(node);
        }
    }

    private void AddScript(SceneNodeSnapshot node)
    {
        if (ScriptTemplate.Normalize(_search) is not { } name)
        {
            return;
        }

        CloseAddMenu();
        Host.AddScript(node.Id, name);
    }

    /// <summary>Takes the focus once the box is on screen: an inline menu cannot use the autofocus attribute.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusSearch)
        {
            return;
        }

        _focusSearch = false;

        try
        {
            await _searchBox.FocusAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or JSDisconnectedException)
        {
            // No element to focus and no browser to focus it in; the menu still works with the mouse.
        }
    }

    /// <summary>The catalog entries this object does not have yet: an object holds one of each type.</summary>
    private static IReadOnlyList<ComponentCatalog.Entry> AddableTypes(SceneNodeSnapshot node) =>
        ComponentCatalog.BuiltIn
            .Where(entry => !node.Components.Any(component =>
                String.Equals(component.TypeName, entry.ComponentType.Name, StringComparison.Ordinal)))
            .ToArray();

    private void AddComponent(SceneNodeSnapshot node, ComponentCatalog.Entry entry)
    {
        CloseAddMenu();
        Host.AddComponent(node.Id, entry.DisplayName);
    }

    private void Rename(SceneNodeSnapshot node, string? name)
    {
        if (name is null || String.Equals(name, node.Name, StringComparison.Ordinal))
        {
            return;
        }

        Host.RenameObject(node.Id, name);
        Touched(node.Id.ToString() + ":name");
    }

    private void OnTransformChanged(SceneNodeSnapshot node, TransformRow row, int axis, string? text)
    {
        if (!TryParse(text, out float value))
        {
            return;
        }

        Vector3 updated = row.Value;
        updated = axis switch
        {
            0 => new Vector3(value, updated.Y, updated.Z),
            1 => new Vector3(updated.X, value, updated.Z),
            _ => new Vector3(updated.X, updated.Y, value)
        };

        // Live: the row moves with the pointer, and the whole drag is one undo step.
        Host.SetTransformLive(node.Id, row.Field, updated.X, updated.Y, updated.Z);
    }

    /// <summary>A checkbox or a dropdown: one value, one step.</summary>
    private void OnPropertyChanged(
        SceneNodeSnapshot node, ComponentSnapshot component, PropertySnapshot property, string? text)
    {
        Host.SetProperty(node.Id, component.TypeName, property.Name, text ?? string.Empty);
        Touched(PropertyKey(node, component, property));
    }

    /// <summary>A number the pointer is moving: applied every frame, recorded once.</summary>
    private void OnPropertyDragged(
        SceneNodeSnapshot node, ComponentSnapshot component, PropertySnapshot property, string? text)
    {
        Host.SetPropertyLive(node.Id, component.TypeName, property.Name, text ?? string.Empty);
    }

    /// <summary>One axis of a vector: the other components come from the snapshot, so the row stays whole.</summary>
    private void OnVectorChanged(
        SceneNodeSnapshot node, ComponentSnapshot component, PropertySnapshot property, int axis, string? text)
    {
        if (!TryParse(text, out float value))
        {
            return;
        }

        string[] parts = property.Components.Select(Format).ToArray();
        parts[axis] = Format(value);

        Host.SetPropertyLive(node.Id, component.TypeName, property.Name, String.Join(", ", parts));
    }

    /// <summary>A colour picker hands back #rrggbb; the property holds normalized components.</summary>
    private void OnColourChanged(
        SceneNodeSnapshot node, ComponentSnapshot component, PropertySnapshot property, string? hex)
    {
        if (hex is null || hex.Length != 7 || hex[0] != '#')
        {
            return;
        }

        string text = String.Join(", ", new[]
        {
            Format(Convert.ToInt32(hex.Substring(1, 2), 16) / 255f),
            Format(Convert.ToInt32(hex.Substring(3, 2), 16) / 255f),
            Format(Convert.ToInt32(hex.Substring(5, 2), 16) / 255f)
        });

        Host.SetProperty(node.Id, component.TypeName, property.Name, text);
    }

    private static string Hex(IReadOnlyList<float> components)
    {
        static int Channel(float value) => (int)Math.Clamp(MathF.Round(value * 255f), 0f, 255f);

        return String.Format(
            CultureInfo.InvariantCulture, "#{0:x2}{1:x2}{2:x2}", Channel(components[0]), Channel(components[1]), Channel(components[2]));
    }

    private static string Format(float value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    /// <summary>A bound as an attribute value: empty means "none", which the drag script reads as no clamp.</summary>
    private static string RangeText(float? bound) => bound is float value ? Format(value) : string.Empty;

    private static bool TryParse(string? text, out float value) =>
        Single.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value);

    protected override void OnInitialized()
    {
        Store.Changed += OnSceneChanged;
        Selection.Changed += OnSceneChanged;
    }

    private void OnSceneChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Store.Changed -= OnSceneChanged;
        Selection.Changed -= OnSceneChanged;
    }
}
