@inject IJSRuntime JS
@inject SceneStore Store
@implements IAsyncDisposable

@* ImGui's Viewport window: scene tab strip, the Options toolbar row, then the render surface. *@
<section class="panel viewport-panel">
    <header class="panel-tabstrip">
        <span class="panel-tab active">@SceneName</span>
        <span class="panel-tab-spacer"></span>
        <span class="panel-tab-meta">@ObjectCount objects</span>
    </header>

    <div class="viewport-toolbar">
        <button type="button" class="imgui-button" @onclick="ToggleOptions">Options</button>

        @if (_optionsOpen)
        {
            <div class="menu-popup" role="menu">
                <button type="button" class="menu-item" role="menuitem" disabled
                        title="The grid is a renderer setting owned by the engine">
                    <span>Show Grid</span>
                </button>
            </div>
            <div class="menu-scrim" @onclick="() => _optionsOpen = false"></div>
        }
    </div>

    <div class="panel-body viewport-body">
        <div class="viewport-frame">
            <canvas id="viewport-canvas" tabindex="0"></canvas>
            <div id="viewport-canvas-overlay" class="viewport-overlay" hidden></div>
        </div>
    </div>
</section>

@code {
    /// <summary>WebSocket endpoint of the in-process editor host.</summary>
    [Parameter]
    public string WebSocketUrl { get; set; } = string.Empty;

    private bool _mounted;
    private bool _optionsOpen;

    private string SceneName => Store.Current?.SceneName ?? "Viewport";

    private int ObjectCount => Store.Current?.Nodes.Count ?? 0;

    private void ToggleOptions()
    {
        _optionsOpen = !_optionsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _mounted || string.IsNullOrEmpty(WebSocketUrl))
        {
            return;
        }

        // "First render only" is not enough on its own: the interop call is async, so the flag also stops a
        // second render pass from mounting the bridge twice.
        _mounted = true;

        try
        {
            await JS.InvokeVoidAsync("cherrisViewport.mount", "viewport-canvas", WebSocketUrl);
        }
        catch (JSDisconnectedException)
        {
            _mounted = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_mounted)
        {
            return;
        }

        _mounted = false;

        try
        {
            await JS.InvokeVoidAsync("cherrisViewport.dispose");
        }
        catch (Exception)
        {
            // The webview can already be gone while the window is closing; the bridge dies with it.
        }
    }
}
