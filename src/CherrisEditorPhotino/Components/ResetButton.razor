@* The reset slot that ends every editable row: an arrow that puts the value back to what a freshly constructed
   component has. Two looks only — washed out and inert when the value is already there, a filled button with an
   arrow at full strength when it is not — so what you see is what a click would do, never a shade in between.
   The slot keeps its width either way, so the value column of every row lines up. *@
<button type="button" class="prop-reset @(CanReset ? "modified" : null)"
        disabled="@(!CanReset)" title="@Title" aria-label="@(Label is null ? Title : Label + ": " + Title)"
        @onclick="OnReset">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M13.2 8.1a5.2 5.2 0 1 1-1.7-3.9" fill="none" stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" />
        <path d="M13.5 1.9v3.4H10.1" fill="none" stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round" />
    </svg>
</button>

@code {
    /// <summary>
    /// True when the value differs from the default. That is the only time the button works, and the only time it
    /// is drawn at full strength.
    /// </summary>
    [Parameter]
    public bool CanReset { get; set; }

    /// <summary>What resetting would restore, as the row shows it, for the tooltip. Null when there is none.</summary>
    [Parameter]
    public string? Default { get; set; }

    /// <summary>The row this button belongs to, so a screen reader reads "Position: reset to 0, 0, 0".</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>The edit to queue. It only runs while <see cref="CanReset"/> is true, because the button is disabled otherwise.</summary>
    [Parameter]
    public EventCallback OnReset { get; set; }

    private string Title => CanReset
        ? "Reset to " + (Default ?? "the default")
        : "Already at " + (Default ?? "the default");
}
