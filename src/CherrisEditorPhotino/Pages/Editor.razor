@page "/editor"
@inject EditorHostService Host
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Host.SessionName — Cherris Editor</PageTitle>

@* Mirrors the ImGui editor's chrome: menu bar, centred transport toolbar, dockspace, status strip. *@
<div class="editor-shell">
    <MenuBar />
    <ToolBar />

    @if (Host.State == EditorSessionState.Failed)
    {
        <div class="editor-error">
            <h2>The editor host is not running</h2>
            <p>@(Host.FailureMessage ?? "The renderer stopped.")</p>

            @if (Host.FailureDetail is string detail)
            {
                <pre class="editor-error-detail">@detail</pre>
            }

            <div class="editor-error-actions">
                <button type="button" class="editor-button" @onclick="CopyDiagnostics">Copy diagnostics</button>
                <button type="button" class="editor-button" @onclick="BackToLauncher">Back to projects</button>
                @if (_copied)
                {
                    <span class="editor-error-confirm">copied to the clipboard</span>
                }
            </div>

            @if (Host.LogFilePath is string logPath)
            {
                <p class="editor-error-hint">Log file: <code>@logPath</code></p>
            }

            <h3>Host log</h3>
            <pre class="editor-log">@Host.LogTail(40)</pre>
        </div>
    }
    else if (Host.State == EditorSessionState.Starting)
    {
        <div class="editor-starting">Starting the renderer for @Host.SessionName…</div>
    }
    else
    {
        <div class="dockspace" id="dockspace">
            <div class="dock-pane">
                <HierarchyPanel />
            </div>

            <div class="dock-splitter dock-splitter-x" data-dock-splitter="1" data-axis="x" data-target="left"
                 role="separator" aria-orientation="vertical" title="Drag to resize the hierarchy"></div>

            <div class="dock-middle">
                <div class="dock-pane">
                    <ViewportPanel WebSocketUrl="@Host.WebSocketUrl" />
                </div>

                <div class="dock-splitter dock-splitter-y" data-dock-splitter="1" data-axis="y" data-target="bottom"
                     role="separator" aria-orientation="horizontal" title="Drag to resize the bottom dock"></div>

                <div class="dock-pane">
                    <section class="panel">
                        <header class="panel-tabstrip">
                            <button type="button" class="panel-tab @(_bottomTab == "content" ? "active" : "")"
                                    @onclick='() => _bottomTab = "content"'>
                                Content Browser
                            </button>
                            <button type="button" class="panel-tab @(_bottomTab == "console" ? "active" : "")"
                                    @onclick='() => _bottomTab = "console"'>
                                Console
                            </button>
                        </header>

                        <div class="panel-body nopad">
                            @if (_bottomTab == "content")
                            {
                                <ContentBrowserPanel />
                            }
                            else
                            {
                                <ConsolePanel />
                            }
                        </div>
                    </section>
                </div>
            </div>

            <div class="dock-splitter dock-splitter-x" data-dock-splitter="1" data-axis="x" data-target="right"
                 role="separator" aria-orientation="vertical" title="Drag to resize the inspector"></div>

            <div class="dock-pane">
                <InspectorPanel />
            </div>
        </div>

        <StatusBar />
    }
</div>

@code {
    private static readonly TimeSpan HealthInterval = TimeSpan.FromMilliseconds(500);

    private Timer? _timer;
    private bool _copied;
    private bool _dockMounted;
    private string? _lastFailure;
    private EditorSessionState _lastState;
    private string _bottomTab = "content";

    protected override void OnInitialized()
    {
        _lastFailure = Host.FailureMessage;
        _lastState = Host.State;

        // Deep-linking to /editor with nothing open (or a reload after a crash) belongs on the launcher.
        if (Host.State == EditorSessionState.Idle)
        {
            Nav.NavigateTo("/");
        }

        // The render thread can die long after the window opened (a driver reset, a lost context), so the
        // page watches for the first failure instead of only checking once at startup.
        _timer = new Timer(_ => _ = CheckHealthAsync(), null, HealthInterval, HealthInterval);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dockMounted || Host.State != EditorSessionState.Running)
        {
            return;
        }

        // mount() reports false when #dockspace is not in the DOM yet (the first render is still the
        // "starting" state), so stay unmounted and try again on the next render.
        try
        {
            _dockMounted = await JS.InvokeAsync<bool>("cherrisDock.mount");
        }
        catch (JSDisconnectedException)
        {
            // The webview is going away; nothing left to wire up.
        }
    }

    private async Task CheckHealthAsync()
    {
        if (Host.FailureMessage == _lastFailure && Host.State == _lastState)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            _lastFailure = Host.FailureMessage;
            _lastState = Host.State;
            StateHasChanged();
        });
    }

    private void BackToLauncher()
    {
        Host.CloseSession();
        Nav.NavigateTo("/");
    }

    private async Task CopyDiagnostics()
    {
        try
        {
            _copied = await JS.InvokeAsync<bool>("cherrisHost.copy", Host.Diagnostics);
        }
        catch (Exception)
        {
            _copied = false;
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}
